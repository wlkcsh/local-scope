# Local-Scope Configuration
# Copy this to .env and fill in your values

# Database connection URL (defaults to SQLite in WAL mode; use postgresql:// for production)
DATABASE_URL=sqlite:///../data/app.db

# Storage directories
DATA_DIR=../data
TMP_DIR=/tmp/local-scope

# FACEIT API Credentials (Required for automated match room ingestion and signed downloads)
FACEIT_API_KEY=
FACEIT_DOWNLOAD_KEY=

# Personal 64-bit SteamID (for default player focus in dashboard)
MY_STEAMID=

# Optional Bearer Token for securing /api/* routes (e.g. for n8n webhooks)
API_TOKEN=

# Multi-User Auth & Squad Privacy
# Generate a strong secret for production: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-strong-32-char-random-secret
# Optional secret club invite code required to register (leave blank for open signup)
INVITE_CODE=

# CORS allowed origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000"]

# Optional regex for dynamic Vercel preview deployments (e.g. ^https://local-scope-[a-z0-9-]+\.vercel\.app$)
CORS_ORIGIN_REGEX=

# AWS Backend Auto-HTTPS domain for Caddy (e.g. 51-20-19-230.sslip.io or scope-api.yourdomain.com)
API_DOMAIN=

# Frontend -> Backend URLs (configure these in Vercel Project Settings -> Environment Variables)
# BACKEND_URL=https://51-20-19-230.sslip.io
# NEXT_PUBLIC_DIRECT_BACKEND_URL=https://51-20-19-230.sslip.io
# NEXT_PUBLIC_API_TOKEN=

# Maximum allowed decompressed demo size in bytes (1.5 GB limit)
MAX_DEM_BYTES=1500000000
