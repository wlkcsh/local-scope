# ==============================================================================
# Local-Scope .gitignore
# Stack: FastAPI / Python (uv, pytest) + Next.js 15 / React 19 (pnpm, Vitest)
# ==============================================================================

# --- Virtual Environments & Python ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
*.egg-info/
.eggs/
dist/
build/

# --- Node.js, Next.js & TypeScript ---
node_modules/
.next/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- CS2 Demo Files & Fixtures ---
*.dem
*.dem.gz
*.dem.zst
*.dem.bz2
demos/
/dust2-11-13-clutch*
!**/tests/fixtures/.gitkeep

# --- Databases, Replays & Runtime Output ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
**/replays/*.json.gz
/data/
/backend/data/
/out/
/backend/out/
/frontend/out/

# --- Knowledge Graph & Tooling Caches ---
.agents/
graphify-out/
*.log

# --- Credentials & Environment Files ---
.env
.env.*
*.env
!.env.example
!.env.template

# --- OS & Editors ---
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
